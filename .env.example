# Meta Model API (Muse Spark). Get the key from your Meta developer account.
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# minimal answers about twice as fast as low, with replies just as good for conversation
META_REASONING_EFFORT=minimal

# Speech recognition (Meta MMS)
# Comma-separated; every model transcribes and Muse Spark compares the versions
ASR_MODELS=waxal-benchmarking/mms-300m-waxal-ewe,facebook/mms-1b-all
ASR_LANGUAGE=ewe
# Hears English and French on the Translate page (shared with ASR_MODELS when listed there)
MULTILINGUAL_ASR_MODEL=facebook/mms-1b-all

# Existing EchoVoiice TTS API (run it separately, e.g. docker-compose up in the echoVoiice repo)
ECHOVOIICE_URL=http://localhost:8000
ECHOVOIICE_API_KEY=
# Or leave the key empty and let the assistant create an EchoVoiice account and key on first use
# (docker compose sets these for you)
ECHOVOIICE_ACCOUNT_EMAIL=
ECHOVOIICE_ACCOUNT_PASSWORD=
# Speaking speed, 0.5 to 2.0 (the voice learned from slow Bible readings)
TTS_SPEED=1.1
# Use Meta MMS-TTS for Ewe when EchoVoiice is unreachable
USE_TTS_FALLBACK=true
TTS_FALLBACK_MODEL=facebook/mms-tts-ewe
# After EchoVoiice fails, use the fallback voice straight away for this many seconds
ECHOVOIICE_RETRY_SECONDS=300

# Conversation
# Assistant for new Talk sessions: general (talk about anything) or hospital (reception guide)
DEFAULT_MODE=general
# How many earlier exchanges the assistant remembers
MAX_HISTORY_TURNS=12
# Hospital facts the hospital guide may repeat (default: app/data/hospital.json)
# FACILITY_FILE=

# Load and warm up the speech models at startup instead of on the first request
PRELOAD_MODELS=false
